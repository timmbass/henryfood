# Food Diary App Configuration
# Copy this to .env and fill in your values

# Override the default SQLite database path
# FOOD_DIARY_DB=/path/to/your/food_diary.db

# Set to 'true' to enable debug logging
# FOOD_DIARY_DEBUG=false

# Ollama configuration (if using LLM parsing)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3

# Remote LAN service (for Raspberry Pi offloading)
# REMOTE_SERVICE_URL=http://192.168.1.100:8000
